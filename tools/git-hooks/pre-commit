#!/bin/sh
# Runs the documentation check when Markdown is staged, and refuses to commit
# CLAUDE.md, which is local only in an app (see docs/CONTRIBUTING.md,
# "Commits"). An app is recognized as .claude/hooks/guard-bash.sh does it: by
# init-project.sh's line in .git/info/exclude. The template tracks CLAUDE.md.
set -e

exclude="$(git rev-parse --git-path info/exclude)"
if [ -f "$exclude" ] && grep -qx 'CLAUDE.md' "$exclude" &&
   git diff --cached --name-only --diff-filter=ACMR | grep -qx 'CLAUDE.md'; then
    echo "pre-commit: CLAUDE.md is local only and must not be committed." >&2
    echo "            git rm --cached CLAUDE.md" >&2
    exit 1
fi

if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.md$'; then
    python3 tools/check-docs.py
fi
