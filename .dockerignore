# Keep the build context (and final image) clean.
.git
.gitignore
.dockerignore
.github
.claude
.venv/
.pytest_cache/
**/__pycache__/
*.pyc
*.pyo

# Runtime data and secrets: never bake these into an image.
.env
data/
temp/
*.db
*.key

# Docs, tests and release tooling are not needed at runtime.
docs/
tests/
tools/
*.md
CONTRIBUTORS
LICENSE
